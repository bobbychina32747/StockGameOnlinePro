{
  "name": "stockgame-remaster",
  "version": "2.0.0-dev",
  "private": true,
  "scripts": {
    "prepare:local": "node tooling/runner.cjs catalog",
    "build:api": "node tooling/runner.cjs build-api",
    "build:web": "node tooling/runner.cjs build-web",
    "build": "npm run build:api && npm run build:web",
    "test": "node --require ./tooling/runtime.cjs --test tests/*.test.cjs",
    "start": "node --require ./tooling/runtime.cjs dist/apps/game-api/main.js",
    "dev:web": "node tooling/runner.cjs dev-web",
    "typecheck:web": "node tooling/runner.cjs typecheck-web",
    "verify": "npm run build && npm run typecheck:web && npm test"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "better-sqlite3": "12.4.1",
    "echarts": "5.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "5.5.4",
    "vite": "5.4.21"
  }
}
