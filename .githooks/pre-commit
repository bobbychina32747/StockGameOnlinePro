#!/bin/sh
# Phase 0 提交前检查（快速门禁）：backend tsc + 全量测试，frontend eslint。
# 重型检查（vite 生产构建、smoke）由 GitHub Actions CI 承担，不在本地提交路径重复。
set -e

# P1: 交易日历前后端副本必须字节级一致（防止漂移）
if ! cmp -s backend/src/common/data/trading-calendar.ts frontend/src/data/trading-calendar.ts; then
  echo "[pre-commit] 交易日历前后端副本不一致: backend/src/common/data/trading-calendar.ts vs frontend/src/data/trading-calendar.ts"
  exit 1
fi

if [ -d backend/node_modules ]; then
  echo "[pre-commit] backend build..."
  (cd backend && npm run build --silent) || { echo "[pre-commit] backend build FAILED"; exit 1; }
  echo "[pre-commit] backend tests..."
  (cd backend && npm test -- --runInBand --silent) || { echo "[pre-commit] backend tests FAILED"; exit 1; }
fi

if [ -d frontend/node_modules ]; then
  echo "[pre-commit] frontend lint..."
  (cd frontend && npm run lint --silent) || { echo "[pre-commit] frontend lint FAILED"; exit 1; }
  echo "[pre-commit] frontend typecheck..."
  (cd frontend && npx tsc -b) || { echo "[pre-commit] frontend typecheck FAILED"; exit 1; }
fi

exit 0
