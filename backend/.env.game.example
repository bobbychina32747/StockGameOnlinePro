# New local setup only. Preserve the existing game JWT secret during a migration.
NODE_ENV=development
TZ=Asia/Shanghai
PORT=8000
DB_TYPE=sqlite
SQLITE_PATH=./data/game/stockgame.db
DB_SYNCHRONIZE=true
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=24h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TICK_INTERVAL_MS=60000
SANDBOX_FAST=false
FORMAL_CONTINUOUS_SIMULATION=false
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
TRUST_PROXY=0
# External HTTP authority only. No identity signing keys or site credentials.
SITE_IDENTITY_URL=http://127.0.0.1:8010
