# ─── 应用配置 ───
APP_NAME=StockSimulatorPro
NODE_ENV=development
PORT=8000

# ─── 数据库驱动 ───
# sqlite（默认）= better-sqlite3 原生驱动（WAL 增量写盘，推荐；与旧 sql.js 数据文件完全兼容）
# sqljs = 旧内存驱动（定时全库导出，兼容模式）
# postgres = 生产环境推荐（需同时配置下方 DB_* 项）
DB_TYPE=sqlite
SQLITE_PATH=./data/stockgame.db

# ─── 数据库 (PostgreSQL) ───
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=stockgame
DB_PASSWORD=stockgame_dev_2024
DB_DATABASE=stockgame

# ─── 表结构同步（R5-⑩）───
# TypeORM synchronize：是否让后端按实体定义自动建表/改表。三个 DB_TYPE 分支共用此开关。
# 开发方便，默认 true（保持向后兼容，不设置即为 true）。
# ⚠️ 生产环境务必改为 false：否则升级代码时可能自动改动生产表结构（丢列/改类型不可逆），
#    建议改用迁移（migrations）管理表结构。
# ⚠️ 置为 false 后库表不会自动创建：首次部署需自行建表或执行迁移脚本，否则启动后查询会报表不存在。
DB_SYNCHRONIZE=true

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ───
# ⚠️ 生产环境必须修改为强随机密钥（否则后端会拒绝启动）
# 生成命令：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ─── 管理员账号（首次启动自动创建） ───
# 生产环境务必设置强密码（>=8位），否则后端拒绝创建默认管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ─── 行情生成 ───
# 每个行情 tick 的真实间隔毫秒数：60000=实时行情（真实 1 分钟 1 根 bar，全天约 4 小时，默认）；
# 1000=高速回放（1秒=1分钟，适合体验完整交易日）。范围 200~60000。
# ⚠️ TICK_INTERVAL_MS < 60000 必须同时 SANDBOX_FAST=true（沙盒演示确认），否则后端拒绝启动
# （快档下日息/IPO/分红按游戏日加速，与真实市场口径不符）。演示请用仓库根目录 start-fast.bat。
TICK_INTERVAL_MS=60000
SANDBOX_FAST=
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=0

# ─── 机器人玩家（算法盘，Phase G-2）───
# 一批由算法驱动的"假人玩家"：它们是真实的 users 行（isBot=true）+ CN/HK/US 三个真实账户，
# 与真人**同一套权限、同一套规则**（委托走 OrderService 全量校验：休市/涨跌停/购买力/T+1/手续费
# 一律照办），并正常出现在排行榜与赛季里同台竞技——不是既有「AI 对手盘」（那是虚拟账本，不落订单、不进榜）。
# 名册在首次行情 tick 时懒创建（幂等：重启不会重复建号，缺失的账户会自动补齐）。
BOT_PLAYERS_ENABLED=true
# 名册条数（钳制 0~20；0 = 一个都不建）
BOT_PLAYERS_COUNT=6
# 每个机器人每 N 个行情 tick 最多做一次决策（钳制 1~1000）——快档（1 秒 1 tick）下必须靠它限流
BOT_PLAYERS_TRADE_EVERY_TICKS=10
# 每个机器人每游戏日最多成功下单数（钳制 0~200）——防止机器人在快档下写出海量订单
BOT_PLAYERS_MAX_ORDERS_PER_DAY=12
# 机器人自动报名赛季：默认 **关闭**（未设为 'true' 一律不报名）。
# ⚠️ 为什么默认关：赛季的首个报名者会把赛季从"报名中"直接推进为"进行中"并定格起始基准
#    （见 season.service.ts 的 enroll）——机器人抢先报名 = 替全体真人提前开赛、关掉真人报名窗口。
#    同台竞技不靠机器人起跑：全服排行榜本来就人机同榜；等"真人先报才允许机器人报名"的判定做好再打开。
BOT_PLAYERS_SEASON_ENROLL=false
