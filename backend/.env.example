# ─── 应用配置 ───
APP_NAME=StockSimulatorPro
NODE_ENV=development
PORT=8000

# ─── 数据库驱动 ───
# sqlite（默认）= better-sqlite3 原生驱动（WAL 增量写盘，推荐；与旧 sql.js 数据文件完全兼容）
# sqljs = 旧内存驱动（定时全库导出，兼容模式）
# postgres = 生产环境推荐（需同时配置下方 DB_* 项）
DB_TYPE=sqlite
SQLITE_PATH=./data/stockgame.db

# ─── 数据库 (PostgreSQL) ───
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=stockgame
DB_PASSWORD=stockgame_dev_2024
DB_DATABASE=stockgame

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ───
# ⚠️ 生产环境必须修改为强随机密钥（否则后端会拒绝启动）
# 生成命令：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ─── 管理员账号（首次启动自动创建） ───
# 生产环境务必设置强密码（>=8位），否则后端拒绝创建默认管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ─── 行情生成 ───
# 每个行情 tick 的真实间隔毫秒数：1000=高速回放（1秒=1分钟，适合体验完整交易日）；
# 60000=实时行情（真实 1 分钟 1 根 bar，全天约 4 小时）。范围 200~60000。
TICK_INTERVAL_MS=1000
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=0
